# Resurrection runtime
# Where queued run JSON is stored (defaults to OS temp dir).
PROJECT_RESURRECTION_RUN_DIR=

# Preview URL returned after a successful resurrection.
PROJECT_RESURRECTION_PREVIEW_URL=

# Browser iframe target. Do NOT set to /mocks/complete or /create/* (causes nested UI).
NEXT_PUBLIC_PROJECT_RESURRECTION_PREVIEW_URL=

# Daytona sandbox
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=

# OpenAI repair planner
OPENAI_API_KEY=
OPENAI_REPAIR_MODEL=gpt-5.6-sol

# Nosana GPU visual proof for GUI projects
NOSANA_API_KEY=
NOSANA_MARKET=
NOSANA_VISUAL_ENDPOINT_URL=

# Optional helpers
GITHUB_TOKEN=
