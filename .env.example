# Resurrection runtime
# Demo mode runs local deterministic adapters (no external APIs).
PROJECT_RESURRECTION_DEMO_MODE=false

# Where queued run JSON is stored (defaults to OS temp dir).
PROJECT_RESURRECTION_RUN_DIR=

# Preview URL returned after a successful resurrection.
# Default: http://localhost:3000/embed/preview (static mock UI — safe in iframe)
# For Orbital Dodge game: http://localhost:3000/preview/live (run npm run demo:preview)
PROJECT_RESURRECTION_PREVIEW_URL=

# Browser iframe target. Do NOT set to /mocks/complete or /create/* (causes nested UI).
NEXT_PUBLIC_PROJECT_RESURRECTION_PREVIEW_URL=

# Port for standalone demo resurrected app (npm run demo:preview)
DEMO_PREVIEW_PORT=5174

# Live resurrection — Daytona sandbox
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=

# Live resurrection — OpenAI repair planner
OPENAI_API_KEY=
OPENAI_REPAIR_MODEL=gpt-5.6-sol

# Optional Nosana GPU visual proof (GUI demos only)
NOSANA_API_KEY=
NOSANA_MARKET=
NOSANA_VISUAL_ENDPOINT_URL=

# Optional helpers
GITHUB_TOKEN=
